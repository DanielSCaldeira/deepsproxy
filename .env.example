# Provider for this local process: deepseek (default), qwen, chatgpt or perplexity.
PROVIDER=deepseek
# QWEN_PROFILE_DIR=qwen_profile
# CHATGPT_PROFILE_DIR=chatgpt_profile
# PERPLEXITY_PROFILE_DIR=perplexity_profile
# PERPLEXITY_SOURCES=none omits the appended "Fontes:" list (inline [n] markers remain).
# PROVIDER_PROFILE_DIR overrides either provider's profile directory.

# --- Server ---
# Port the proxy listens on (default: 3000)
PORT=3000

# Bind host. If unset and API_KEY is unset, defaults to 127.0.0.1 (loopback).
# Setting BIND_HOST to a non-loopback value WITHOUT API_KEY will refuse to start.
# BIND_HOST=0.0.0.0

# API key for protecting endpoints (recommended whenever BIND_HOST is non-loopback).
# Clients send it via "Authorization: Bearer <key>" or "X-API-Key: <key>".
# API_KEY=replace-me-with-a-strong-secret

# Log verbosity: debug | info | warn | error (default: info)
LOG_LEVEL=info

# Persistent local session diagnostics, independent of console and LOG_LEVEL.
# Enabled by default locally; disabled by default in workers and automated tests.
# DEEPSPROXY_DIAGNOSTICS=0
# Relative paths resolve from the project root. Default: logs/deepsproxy-diagnostic.log
# DEEPSPROXY_DIAGNOSTICS_FILE=logs/deepsproxy-diagnostic.log

# Browser console, page errors and network lifecycle (no headers/request/response bodies).
# Enabled locally and in workers; workers also mirror sanitized events to docker logs.
# DEEPSPROXY_BROWSER_LOG=0
# Local default: logs/browser-<provider>.log. Worker default: /profile/browser-diagnostic.log.
# DEEPSPROXY_BROWSER_LOG_FILE=logs/browser-diagnostic.log

# --- Playwright ---
# Run Chromium headless (default: true). Set to "false" only for debugging.
PLAYWRIGHT_HEADLESS=true
# DeepSeek uses native Playwright; Qwen keeps playwright-extra.
# Set to chrome to use an installed Google Chrome; Docker workers ship Chromium.
PLAYWRIGHT_CHANNEL=chromium

# Random pause before opening the browser/chat and before sending a message (ms).
# Applies to regular requests, context summaries and retries. Set both to 0 to disable.
# Invalid ranges fall back to 10000..15000; maximum supported delay is 60000 ms.
DEEPSPROXY_ACTION_DELAY_MIN_MS=10000
DEEPSPROXY_ACTION_DELAY_MAX_MS=15000

# One generation at a time, including summaries and retries. After completion,
# failure or cancellation, draw a fresh uniform pause before the next generation.
# Invalid ranges fall back to 15000..30000; maximum supported delay is 3600000 ms.
# Both 0 disable the generation cooldown (independently of browser action delays).
DEEPSPROXY_REQUEST_DELAY_MIN_MS=15000
DEEPSPROXY_REQUEST_DELAY_MAX_MS=30000
# Cooldown and account blocks persist in <profile>/.generation-state.json.
# Only validated interactive login clears an account block; dates never auto-resume.

# Directory used as the persistent Chromium profile (relative to the project).
# Includes the saved authentication snapshot; keep it to reuse login after restart.
# DEEPSEEK_PROFILE_DIR=deepseek_profile

# How long to wait for the DeepSeek chat input to appear before giving up (ms).
# DEEPSPROXY_CHAT_INPUT_TIMEOUT_MS=8000

# How long to wait for the PoW interception to fire (ms).
# DEEPSPROXY_POW_TIMEOUT_MS=30000

# Optional DeepSeek user agent override. By default use Chromium's native user agent.
# DEEPSEEK_USER_AGENT=Mozilla/5.0 ...

# --- DeepSeek client headers (mirrored to upstream requests) ---
# DEEPSEEK_APP_VERSION=2.0.0
# DEEPSEEK_CLIENT_VERSION=2.0.0
# DEEPSEEK_CLIENT_LOCALE=pt_BR
# DEEPSEEK_ACCEPT_LANGUAGE=pt-BR,pt;q=0.9,en-US;q=0.8,en;q=0.7

# --- Retry / telemetry ---
# Max total attempts per chat request (default: 1; supported: 1..10).
# Login/suspension/PoW failures are never retried. Transient retries use the queue.
# DEEPSPROXY_MAX_ATTEMPTS=1
# Delay between retries in ms (default: 1000)
# DEEPSPROXY_RETRY_DELAY_MS=1000

# Where the auto-detected context-window stats are persisted.
# Defaults to <DEEPSEEK_PROFILE_DIR>/.telemetry.json
# DEEPSPROXY_TELEMETRY_FILE=

# Disable telemetry persistence entirely (set to "1").
# DEEPSPROXY_DISABLE_TELEMETRY_PERSIST=0
